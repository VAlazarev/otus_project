&НаКлиенте
Процедура ОтправитьСообщенияWMS(Команда)
	ОтправитьСообщенияWMSНаСервере(); 
	Элементы.ОчередьКОтправкеWMS.Обновить();
	Элементы.ОчередьКПолучениюТС.Обновить();
КонецПроцедуры

&НаСервере
Процедура ОтправитьСообщенияWMSНаСервере()
	КлиентКомпоненты = ПолучитьКомпонентуСервер();
	ОтправитьСообщенияWMSСервер(КлиентКомпоненты, ЭтаФорма);
КонецПроцедуры



&НаСервереБезКонтекста
Процедура ОтправитьСообщенияWMSСервер(КлиентКомпоненты, Форма)
	
	
	НаборЗаписей = РегистрыСведений.ОчередьСообщенийКОтправкеWMS.СоздатьНаборЗаписей();  			
	НаборЗаписей.Отбор.Отправлено.Установить(Ложь);
	НаборЗаписей.Прочитать();  
	Попытка
		КлиентКомпоненты.Connect(
		Форма.Адрес,
		Форма.Порт,
		Форма.Логин,
		Форма.Пароль,
		Форма.ВиртуальныйХост); 
		
		ТочкаОбмена    = Форма.ТочкаОбменаWMS;
		ИмяОчереди     = Форма.ИмяОчередиТС;
		
		Для каждого СтрокаНабора Из НаборЗаписей Цикл 
			
			
			КлиентКомпоненты.BasicPublish(
			ТочкаОбмена,
			"#" + ИмяОчереди + "#",
			СтрокаНабора.Сообщение,
			1,
			Ложь); 
			
			
			МенеджерЗаписи =РегистрыСведений.ОчередьСообщенийКОтправкеWMS.СоздатьМенеджерЗаписи();
			МенеджерЗаписи.ID=СтрокаНабора.ID; 
			МенеджерЗаписи.Прочитать();
			МенеджерЗаписи.Отправлено =Истина;                        
			МенеджерЗаписи.Записать();
			
		КонецЦикла;
		
		
	Исключение
		СистемнаяОшибка = ОписаниеОшибки();
		ТекстСообщения = "Ошибка отправки сообщения!%СистемнаяОшибка%";
		ТекстСообщения = СтрЗаменить(ТекстСообщения, "%СистемнаяОшибка%", СистемнаяОшибка);
		ВызватьИсключение ТекстСообщения;
	КонецПопытки; 
	
	Сообщить("Сообщение успешно отправлено!"); 
	
КонецПроцедуры

