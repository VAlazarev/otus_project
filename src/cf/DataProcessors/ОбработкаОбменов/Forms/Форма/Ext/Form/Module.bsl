&НаСервереБезКонтекста
Процедура ОтправитьСообщенияТССервер(КлиентКомпоненты, Форма)
	
	
	НаборЗаписей = РегистрыСведений.ОчередьСообщенийКОтправкеТС.СоздатьНаборЗаписей();  			
	НаборЗаписей.Отбор.Отправлено.Установить(Ложь);
	НаборЗаписей.Прочитать();  
	Попытка
		КлиентКомпоненты.Connect(
		Форма.Адрес,
		Форма.Порт,
		Форма.Логин,
		Форма.Пароль,
		Форма.ВиртуальныйХост); 
		
		ТочкаОбмена    = Форма.ТочкаОбменаТС;
		ИмяОчереди     = Форма.ИмяОчередиWMS;
		
		Для каждого СтрокаНабора Из НаборЗаписей Цикл 
			
			
			КлиентКомпоненты.BasicPublish(
			ТочкаОбмена,
			"#" + ИмяОчереди + "#",
			СтрокаНабора.Сообщение,
			1,
			Ложь); 
			
			
			МенеджерЗаписи =РегистрыСведений.ОчередьСообщенийКОтправкеТС.СоздатьМенеджерЗаписи();
			МенеджерЗаписи.ID=СтрокаНабора.ID; 
			МенеджерЗаписи.Прочитать();
			МенеджерЗаписи.Отправлено =Истина;                        
			МенеджерЗаписи.Записать();
			
		КонецЦикла;
		
		
	Исключение
		СистемнаяОшибка = ОписаниеОшибки();
		ТекстСообщения = "Ошибка отправки сообщения!%СистемнаяОшибка%";
		ТекстСообщения = СтрЗаменить(ТекстСообщения, "%СистемнаяОшибка%", СистемнаяОшибка);
		ВызватьИсключение ТекстСообщения;
	КонецПопытки; 
	
	Сообщить("Сообщение успешно отправлено!"); 
	
КонецПроцедуры

